{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": "incomplete",
        "model": {
          "type": "minecraft:model",
          "model": "projectflint:item/recipe_parchment_incomplete"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:condition",
      "property": "minecraft:has_component",
      "component": "minecraft:custom_data",
      "on_true": {
        "type": "minecraft:model",
        "model": "projectflint:item/recipe_parchment_filled"
      },
      "on_false": {
        "type": "minecraft:model",
        "model": "projectflint:item/recipe_parchment"
      }
    }
  }
}
