{
  "multipart": [
    {
      "when": { "branches": "1|2|3|4|5|6|7|8" },
      "apply": { "model": "projectflint:block/flint_tool_assembly" }
    },
    { "when": { "burnt_branches": "1" }, "apply": { "model": "projectflint:block/flint_tool_assembly_burnt_branch_1" } },
    { "when": { "burnt_branches": "2" }, "apply": { "model": "projectflint:block/flint_tool_assembly_burnt_branch" } },
    { "when": { "flint": "1" }, "apply": { "model": "projectflint:block/flint_tool_assembly_flint" } },
    { "when": { "flint": "2" }, "apply": { "model": "projectflint:block/flint_tool_assembly_flint_2" } }
  ]
}
