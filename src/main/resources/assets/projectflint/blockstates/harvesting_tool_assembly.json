{
  "multipart": [
    {
      "when": {
        "bindings": "1"
      },
      "apply": {
        "model": "projectflint:block/harvesting_tool_assembly_binding_1"
      }
    },
    {
      "when": {
        "bindings": "2"
      },
      "apply": {
        "model": "projectflint:block/harvesting_tool_assembly_binding_2"
      }
    },
    {
      "when": {
        "stones": "1"
      },
      "apply": {
        "model": "projectflint:block/harvesting_tool_assembly_stone_1"
      }
    },
    {
      "when": {
        "stones": "2"
      },
      "apply": {
        "model": "projectflint:block/harvesting_tool_assembly_stone_2"
      }
    },
    {
      "when": {
        "has_twig": "true"
      },
      "apply": {
        "model": "projectflint:block/harvesting_tool_assembly_twig"
      }
    }
  ]
}
